# ── LLM MODELS ────────────────────────────────────────────────────────────────
# Verify available models at https://console.groq.com/playground → Model dropdown
#
# Current stable Groq models (as of 2025):
#   Text-only  : llama-3.3-70b-versatile   (recommended, always available)
#                llama3-70b-8192            (older but very stable)
#   Vision     : meta-llama/llama-4-scout-17b-16e-instruct  (may change — check console)
#                llama-3.2-11b-vision-preview               (stable vision fallback)
#
# NOTE: If you see "model not found" or "400 Bad Request", the model name has
# changed on Groq. Update the values below to current names from the playground.

# Maya (adoption advisor) + Ali (shelter coordinator)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Fallback if above fails → uncomment:
# GROQ_MODEL=llama-3.3-70b-versatile

# Aggression detection — text path (no image)
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Aggression detection — vision path (with key-frame mosaic)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Fallback if above fails → uncomment:
# GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ── YOLO MODEL ────────────────────────────────────────────────────────────────
YOLO_POSE_MODEL=yolov8l-pose.pt

